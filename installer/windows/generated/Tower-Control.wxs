  <Product Id="80D2A97D-4C0A-42F9-9058-E1C5ED1B9C04" Name="Tower Control" Language="1033" Version="0.11.4" Manufacturer="RF Tower Project" UpgradeCode="6B9BA4B0-6F56-45E6-94BC-AEF7A7C6C94B">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Description="RF Tower Windows control application and background agent" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Tower Control is already installed." />
    <Property Id="ARPCOMMENTS" Value="Tower Control 0.11.04" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Dimens102/tower" />
    <Icon Id="TowerIcon.ico" SourceFile="$(var.WindowsSource)/assets/tower-icon-tray.ico" />
