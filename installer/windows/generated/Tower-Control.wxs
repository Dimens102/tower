    <DirectoryRef Id="ProgramMenuTowerFolder">
      <Component Id="Cmp_StartMenuShortcut" Guid="4992B766-91BC-57D2-B352-7D7156CC0A97" Win64="yes">
        <Shortcut Id="StartMenuShortcut" Name="Tower Control" Target="[SystemFolder]wscript.exe" Arguments="&quot;[#File_da4a796c15c648fc2013]&quot;" WorkingDirectory="INSTALLFOLDER" Icon="TowerIcon.ico" />
        <RemoveFolder Id="RemoveProgramMenuTowerFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\RF Tower Project\Tower Control" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="Cmp_DesktopShortcut" Guid="D8D1A20C-4EC3-5E80-B2B9-3BA96262D0DF" Win64="yes">
        <Shortcut Id="DesktopShortcut" Name="Tower Control" Target="[SystemFolder]wscript.exe" Arguments="&quot;[#File_da4a796c15c648fc2013]&quot;" WorkingDirectory="INSTALLFOLDER" Icon="TowerIcon.ico" />
        <RegistryValue Root="HKLM" Key="Software\RF Tower Project\Tower Control" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <CustomAction Id="SetPowerShellPath" Property="POWERSHELLEXE" Value="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" />
    <CustomAction Id="ConfigureTower" Property="POWERSHELLEXE" Execute="deferred" Impersonate="yes" Return="check" ExeCommand="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Msi-Configure-Tower.ps1&quot; -Mode Install" />
    <CustomAction Id="RemoveTowerIntegration" Property="POWERSHELLEXE" Execute="deferred" Impersonate="no" Return="ignore" ExeCommand="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Msi-Configure-Tower.ps1&quot; -Mode Remove" />
    <InstallExecuteSequence>
      <Custom Action="SetPowerShellPath" After="CostFinalize">1</Custom>
      <Custom Action="ConfigureTower" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="RemoveTowerIntegration" After="RemoveShortcuts">REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
    <Feature Id="Complete" Title="Tower Control" Level="1" Absent="disallow">
